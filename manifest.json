{
  "manifest_version": 3,
  "name": "Scroll Unlocker",
  "version": "1.2",
  "description": "Removes fullscreen fixed overlays and restores scrolling.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_icon": "icon.png",
    "default_title": "Unlock Scroll"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}